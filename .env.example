# =====================================================
# Agentcy Control - Environment Variables
# =====================================================

# --- Supabase (Required for both apps) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Groq AI Copilot (Required for mission-control) ---
GROQ_API_KEY=groq-api-key-here

# --- Redis (Optional - for caching and rate limiting) ---
# REDIS_URL=redis://localhost:6379

# --- Edge Function Secrets (set via: supabase secrets set KEY=value) ---
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RESEND_API_KEY=your-resend-key
# SENTRY_API_KEY=your-sentry-key
# VERCEL_API_TOKEN=your-vercel-token
# POSTHOG_API_KEY=your-posthog-key
